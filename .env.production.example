# Production configuration. Copy this to the deployment's secret/environment
# store; do not commit the resulting file.

# The application container talks to an already-provisioned Ollama service.
BACKEND=ollama
OLLAMA_HOST=http://ollama.internal:11434
OLLAMA_MODEL_NAME=ai-analyzer-ministral-8b-iq4
OLLAMA_AUTO_CREATE=false

# Mount the source data read-only at this path.
DATA_DIR=/data

# Put mutable state on durable, backed-up storage.
STORE_PATH=/var/lib/ai-analyzer/analyzer.db
OUTPUT_DIR=/var/lib/ai-analyzer/outputs
CACHE_DIR=/var/lib/ai-analyzer/cache
LOG_DIR=/var/log/ai-analyzer

# Leave empty for a safe single-user deployment. Set this only behind an
# authenticated reverse proxy that removes the public header and sets it from
# the authenticated user, for example: AUTH_HEADER=X-Forwarded-User
AUTH_HEADER=

PERSIST_CHATS=true
VERIFY_NUMBERS=true
LOG_LEVEL=INFO
LOG_CONSOLE_LEVEL=INFO
