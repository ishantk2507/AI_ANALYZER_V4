# Copy to `.env` and edit. Every value below is optional -- the defaults are
# what the app uses if the variable is absent.
#
# `.env` is gitignored. Never commit one: it is the file that ends up holding
# machine paths and, on a server, the auth header name.
#
# Every setting is documented in docs/CONFIGURATION.md.

# =============================================================================
# Model
# =============================================================================

# Absolute path to the GGUF. If unset, the app searches (in order):
#   <project>/models/, ~/Downloads/
# MODEL_PATH=/srv/ai-analyzer/models/Ministral-3-8B-Instruct-2512-IQ4_XS.gguf

# auto | ollama | llama_cpp
# "auto" uses Ollama when its server is reachable, else in-process llama.cpp.
BACKEND=auto

OLLAMA_HOST=http://localhost:11434

# Which registered Ollama model answers. Generation throughput on a 6GB RTX 3060
# at num_ctx 4096, with MODEL_N_GPU_LAYERS=-1 forcing full offload
# (scripts/bench_model.py):
#
#   ai-analyzer-ministral        3B Q4_K_M  86.0 tok/s  100% GPU  2.3GB
#   ai-analyzer-ministral-8b-iq4 8B IQ4_XS  50.3 tok/s  100% GPU  5.4GB
#   ai-analyzer-ministral-8b     8B Q4_K_M  43.8 tok/s  100% GPU  5.9GB
#
# An 8B does fit in 6GB, contrary to what the layer split suggests -- left to its
# own estimate Ollama keeps 21-28% on the CPU and runs at 14-21 tok/s, so forcing
# the offload is worth ~3x. IQ4_XS is both faster than Q4_K_M (less weight to read
# per token) and leaves 567MB of VRAM spare against Q4_K_M's 103MB, which is the
# margin that survives a browser opening. Register it with:
#   ollama create ai-analyzer-ministral-8b-iq4 -f modelfiles/ministral-8b-iq4
OLLAMA_MODEL_NAME=ai-analyzer-ministral-8b-iq4

# Send only the interpretation stage to a larger model. Worth it only when both
# models fit in VRAM at once -- on 6GB they do not, so Ollama reloads the 8B on
# every question and the swap costs more than it saves (measured: 41s, no better
# than running the 8B for everything). Leave empty unless you have the headroom.
# INSIGHT_MODEL=ai-analyzer-ministral-8b

# Register the GGUF with Ollama on first run (copies the whole file into Ollama's
# store: ~2GB for the 3B, ~4.7GB for the 8B IQ4_XS).
OLLAMA_AUTO_CREATE=true

MODEL_N_CTX=4096
# -1 = offload every layer to the GPU, overriding Ollama's own estimate of how
# many will fit. Worth ~3x on a 6GB card (see above). The tradeoff: a model that
# genuinely does not fit now fails to load rather than spilling to CPU. Set an
# explicit layer count if you would rather have the graceful split back.
MODEL_N_GPU_LAYERS=-1
# MODEL_N_THREADS=8

STRUCTURED_TEMPERATURE=0.0
NARRATIVE_TEMPERATURE=0.35
MAX_OUTPUT_TOKENS=640

# =============================================================================
# Data
# =============================================================================

# Root of the <category>/<breakdown>.parquet tree. If unset the app uses
# <project>/data.
# DATA_DIR=/srv/ai-analyzer/data

MAX_ROWS_IN_PROMPT=15
MAX_RESULT_ROWS=500
MAX_REPAIR_ATTEMPTS=2
# Check every figure in the narrative against the computed table.
VERIFY_NUMBERS=true
DATASET_CACHE_SIZE=4

# =============================================================================
# Persistence -- chats and standing user preferences
# =============================================================================

# The SQLite database holding users, chats, turns and remembered preferences.
# Relative paths resolve against the project root.
#
# On a server, put this on a disk you back up: it is the only state the app has
# that cannot be regenerated. Everything under .cache/ and outputs/ can.
# STORE_PATH=/var/lib/ai-analyzer/analyzer.db

# false runs entirely in memory -- chats live as long as the process does.
PERSIST_CHATS=true

# Standing facts injected into every prompt. Capped because they compete with
# the schema and the result table for a 4K context window.
MAX_USER_MEMORIES=12
# Chats offered in the sidebar's list.
MAX_CHATS_LISTED=50

# =============================================================================
# Multi-user
# =============================================================================

# Who a session belongs to when nothing identifies the user. Single-user
# installs never see anything else.
DEFAULT_USER=local

# Name of the request header a trusted reverse proxy sets to the authenticated
# username, e.g. X-Forwarded-User. Empty keeps the app in single-user mode.
#
# SECURITY: only ever set this behind a proxy that STRIPS the header from
# inbound client requests and sets it from a real authentication result. A
# header the client can send is not authentication -- anyone could then read
# anyone else's chats by naming them. See docs/DEPLOYMENT.md.
AUTH_HEADER=

# =============================================================================
# Output and logging
# =============================================================================

CHART_DPI=120
# light | dark -- both are selected palette steps, not an automatic flip.
CHART_THEME=light
LOG_LEVEL=INFO
LOG_CONSOLE_LEVEL=WARNING
